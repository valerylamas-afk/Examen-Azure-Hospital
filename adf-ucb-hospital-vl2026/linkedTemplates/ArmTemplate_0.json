		{
			"name": "[concat(parameters('factoryName'), '/DF_Silver_Patients')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Bronze_Patients",
								"type": "DatasetReference"
							},
							"name": "OrigenBronzePatients"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Patients",
								"type": "DatasetReference"
							},
							"name": "DestinoSilverPatients"
						}
					],
					"transformations": [
						{
							"name": "LimpiarPacientes"
						},
						{
							"name": "EliminarDuplicadosPatients"
						}
					],
					"scriptLines": [
						"source(output(",
						"          patient_id as string,",
						"          full_name as string,",
						"          gender as string,",
						"          date_of_birth as string,",
						"          phone as string,",
						"          email as string,",
						"          address as string,",
						"          insurance_provider as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
